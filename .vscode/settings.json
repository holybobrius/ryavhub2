{
  // JS/TS форматирует ESLint (через eslint-plugin-prettier) — встроенный
  // форматтер выключен, иначе на сейв код отформатируется дважды.
  "editor.formatOnSave": false,
  // LF как в репозитории (.gitattributes) — Prettier требует endOfLine: lf.
  "files.eol": "\n",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // CSS/JSON/Markdown ESLint не линтит — их форматирует Prettier с тем же .prettierrc.
  "[css][json][jsonc][markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // Tailwind v4: подсказки классов и без ругани на @theme/@utility.
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  "typescript.tsdk": "node_modules/typescript/lib"
}
